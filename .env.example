# Must exactly match COLLECTIONS_SERVICE_SECRET in the Next.js app's own
# .env — it authenticates requests in both directions. Any random long
# string, e.g. `openssl rand -hex 32`.
COLLECTIONS_SERVICE_SECRET=

# The SAME Cloudflare R2 bucket the Next.js app stores its own photos in
# (its own R2_ACCOUNT_ID / R2_BUCKET_NAME values) — this service writes
# straight into it, so a downloaded board's photos are indistinguishable
# from any other photo a user uploaded. Use a separate R2 API token here
# (Object Read & Write on that one bucket) rather than reusing the app's, so
# either side can be rotated independently.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Optional tuning.
MAX_IMAGES=300
DOWNLOAD_TIMEOUT_SECONDS=20
EXTRACTION_TIMEOUT_SECONDS=120
PORT=8080
